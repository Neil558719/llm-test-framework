# ============================================================
# llmtest 环境变量模板 —— 迁移到新电脑时照此填写
# （PowerShell: $env:VAR = "值"；bash: export VAR=值）
# ============================================================

# ---- 裁判模型（评估回答质量的独立模型；框架侧必填） ----
LLM_TEST_MODE=real
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-sol
LLM_BASE_URL=https://newapi.gosuncn.com/v1
LLM_API_KEY=

# ---- 被测模型（用"裸模型"当被测对象时；用 Dify 应用时不需要） ----
LLM_APP_PROVIDER=openai
LLM_APP_MODEL=deepseek-v4-flash
LLM_APP_BASE_URL=https://newapi.gosuncn.com/v1
LLM_APP_API_KEY=

# ---- Dify 被测机器人（examples/dify_bot/） ----
DIFY_BASE_URL=http://localhost/v1        # 云版用 https://api.dify.ai/v1
DIFY_API_KEY=app-xxx                     # Dify 应用 API 密钥

# ---- 可选 ----
# LLM_EMBEDDING_MODEL=text-embedding-3-small   # 裁判侧 embedding 模型名
# DIFY_LLM_MODEL=deepseek-v4-flash             # Dify 机器人用的生成模型（在 Dify 里配）
