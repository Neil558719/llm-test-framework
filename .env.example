# ============================================================
# llmtest 环境变量模板 —— 复制为 .env 后按需填写，禁止提交真实凭据
# ============================================================
LLM_TEST_MODE=real
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-sol
LLM_BASE_URL=https://newapi.gosuncn.com/v1
LLM_API_KEY=
LLM_APP_PROVIDER=openai
LLM_APP_MODEL=deepseek-v4-flash
LLM_APP_BASE_URL=https://newapi.gosuncn.com/v1
LLM_APP_API_KEY=
DIFY_BASE_URL=http://localhost/v1
DIFY_API_KEY=

# ---- Reference Agent 本机类生产部署 ----
REFERENCE_AGENT_IMAGE=llmtest-reference-agent
IMAGE_TAG=local
BUILD_REV=source
REFERENCE_AGENT_PORT=8000
DATABASE_PATH=/data/reference_agent.db
REFERENCE_AGENT_VOLUME=local-production-drill_reference-agent-data

# ---- Reference Agent 模型运行时（10.5；密钥仅服务端注入） ----
REFERENCE_AGENT_MODEL_MODE=mock
REFERENCE_AGENT_MODEL_PROVIDER=deepseek
REFERENCE_AGENT_MODEL=deepseek-chat
REFERENCE_AGENT_MODEL_BASE_URL=https://api.deepseek.com
REFERENCE_AGENT_MODEL_API_KEY=
REFERENCE_AGENT_MODEL_TEMPERATURE=0

# ---- Production hardening (inject values on a server; never commit secret values) ----
# QE_ENVIRONMENT accepts development or production. Production requires absolute database paths,
# HTTPS OIDC URLs, and the configured secrets below (or matching *_FILE Docker secret paths).
QE_ENVIRONMENT=development
QE_AUTH_DATABASE=auth.db
QE_TELEMETRY_DATABASE=telemetry.db
QE_TELEMETRY_RETENTION_DAYS=30
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=
OIDC_JWKS_URL=
OIDC_ROLES_CLAIM=roles
AUTH_COOKIE_NAME=qe_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_SECRET=
AUTH_SESSION_SECRET_FILE=
QE_TELEMETRY_HASH_KEY=
QE_TELEMETRY_HASH_KEY_FILE=
QE_TELEMETRY_INGEST_TOKEN=
QE_TELEMETRY_INGEST_TOKEN_FILE=
REFERENCE_AGENT_MODEL_API_KEY_FILE=
